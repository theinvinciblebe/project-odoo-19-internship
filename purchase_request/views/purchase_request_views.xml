<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence definition -->
    <data noupdate="1">
        <record id="seq_purchase_request" model="ir.sequence">
            <field name="name">Purchase Request</field>
            <field name="code">purchase.request</field>
            <field name="prefix">PR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

    <!-- Form View -->
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <form string="Purchase Request">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-success" groups="base.group_system" invisible="state != 'submitted'"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" groups="base.group_system" invisible="state != 'submitted'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('approved', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="requested_by" readonly="state != 'draft'"/>
                            <field name="assigned_approver" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date_request" readonly="state != 'draft'"/>
                            <field name="purchase_order_id" invisible="not purchase_order_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Requested Items" name="items">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <!-- Modern Odoo Chatter syntax -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_purchase_request_list" model="ir.ui.view">
        <field name="name">purchase.request.list</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state == 'approved'"
                  decoration-muted="state in ('cancel', 'rejected')">
                <field name="name"/>
                <field name="requested_by" readonly="1"/>
                <field name="date_request"/>
                <field name="assigned_approver"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>
</odoo>