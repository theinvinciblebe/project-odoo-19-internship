<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence definition -->
    <data noupdate="1">
        <record id="seq_purchase_request" model="ir.sequence">
            <field name="name">Purchase Request</field>
            <field name="code">purchase.request</field>
            <field name="prefix">PR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

    <!-- Form View -->
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <form string="Purchase Request">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-success" groups="purchase_request.group_purchase_request_manager,base.group_system" invisible="state != 'submitted'"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" groups="purchase_request.group_purchase_request_manager,base.group_system" invisible="state != 'submitted'"/>
                    <button name="action_create_rfq" string="Create RFQ" type="object" class="oe_highlight" groups="purchase_request.group_purchase_request_manager,purchase.group_purchase_user,base.group_system" invisible="state != 'approved' or purchase_order_id"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state not in ('rejected', 'cancel') or purchase_order_id"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('approved', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_order"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-credit-card"
                                invisible="not purchase_order_id">
                            <field name="purchase_order_count" widget="statinfo" string="Purchase Order"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Requisition Number"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Requisition Details">
                            <field name="requested_by" readonly="state != 'draft'"/>
                            <field name="assigned_approver" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                        </group>
                        <group string="Financial &amp; System">
                            <field name="date_request" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="estimated_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="purchase_order_id" invisible="not purchase_order_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Requested Items" name="items">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="estimated_cost"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="price_subtotal" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description &amp; Notes" name="notes">
                            <group>
                                <field name="description" placeholder="Business justification or requisition notes..." readonly="state != 'draft'"/>
                                <field name="rejection_reason" invisible="state != 'rejected'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- Modern Odoo Chatter syntax -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_purchase_request_list" model="ir.ui.view">
        <field name="name">purchase.request.list</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="requested_by"/>
                <field name="date_request"/>
                <field name="partner_id" optional="show"/>
                <field name="assigned_approver" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="estimated_total" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Estimated"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_purchase_request_kanban" model="ir.ui.view">
        <field name="name">purchase.request.kanban</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="requested_by"/>
                <field name="date_request"/>
                <field name="estimated_total"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong class="o_kanban_record_title fs-5"><field name="name"/></strong>
                                <field name="state" widget="badge"
                                       decoration-info="state == 'draft'"
                                       decoration-warning="state == 'submitted'"
                                       decoration-success="state == 'approved'"
                                       decoration-danger="state == 'rejected'"
                                       decoration-muted="state == 'cancel'"/>
                            </div>
                            <div class="text-muted small mb-1">
                                <i class="fa fa-user me-1" title="Requester"/> <field name="requested_by"/>
                            </div>
                            <div class="text-muted small mb-2">
                                <i class="fa fa-calendar me-1" title="Request Date"/> <field name="date_request"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                <span class="fw-bold text-primary">
                                    <field name="estimated_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </span>
                                <field name="assigned_approver" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_purchase_request_search" model="ir.ui.view">
        <field name="name">purchase.request.search</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <search string="Search Purchase Requests">
                <field name="name" string="Requisition Ref"/>
                <field name="requested_by"/>
                <field name="assigned_approver"/>
                <field name="partner_id" string="Suggested Vendor"/>

                <filter string="My Requests" name="filter_my_requests" domain="[('requested_by', '=', uid)]"/>
                <filter string="To Approve" name="filter_to_approve" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Rejected" name="filter_rejected" domain="[('state', '=', 'rejected')]"/>

                <group>
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Requested By" name="group_requested_by" domain="[]" context="{'group_by': 'requested_by'}"/>
                    <filter string="Approver" name="group_assigned_approver" domain="[]" context="{'group_by': 'assigned_approver'}"/>
                    <filter string="Vendor" name="group_vendor" domain="[]" context="{'group_by': 'partner_id'}"/>
                    <filter string="Request Date" name="group_date" domain="[]" context="{'group_by': 'date_request'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
