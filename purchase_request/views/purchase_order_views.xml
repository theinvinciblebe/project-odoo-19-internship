<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Form View Inheritance - Approval Tab in Notebook -->
    <record id="view_purchase_order_form_inherit_approval" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Approval Tracking" name="approval_tracking">
                    <group>
                        <group string="Audit Log">
                            <field name="approved_by_id" widget="many2one_avatar_user"/>
                            <field name="date_approved"/>
                            <field name="approval_tier"/>
                        </group>
                        <group string="Justification">
                            <field name="approval_notes" placeholder="Enter audit or justification notes..."/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- 2. List View Inheritance - Approval columns -->
    <record id="view_purchase_order_list_inherit_approval" model="ir.ui.view">
        <field name="name">purchase.order.list.inherit.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="approved_by_id" widget="many2one_avatar_user" optional="show"/>
                <field name="date_approved" optional="show"/>
                <field name="approval_tier" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- 3. Form View Inheritance - Injected Approval Panel via XPath -->
    <record id="view_purchase_order_form_inherit_approval_panel" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.approval.panel</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority" eval="30"/>
        <field name="arch" type="xml">
            <!-- Inject Approval Status Banner / Panel directly above the notebook -->
            <xpath expr="//notebook" position="before">
                <group name="approval_panel" string="Order Approval Tracking" class="oe_edit_only">
                    <group name="approval_audit_left">
                        <field name="approval_tier" widget="selection"/>
                        <field name="approved_by_id" widget="many2one_avatar_user" options="{'no_open': True}"/>
                        <field name="date_approved"/>
                    </group>
                    <group name="approval_audit_right">
                        <field name="approval_notes" placeholder="Add justification, policy checks, or compliance comments..."/>
                    </group>
                </group>
            </xpath>

            <!-- Quick Approval Badge in Header Statusbar -->
            <xpath expr="//header" position="inside">
                <field name="approved_by_id" widget="many2one_avatar_user" invisible="not approved_by_id"/>
            </xpath>
        </field>
    </record>

    <!-- 4. Action for Purchase Orders -->
    <record id="action_custom_purchase_orders" model="ir.actions.act_window">
        <field name="name">Purchase Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,kanban,form,pivot,graph,calendar,activity</field>
        <field name="search_view_id" ref="purchase.view_purchase_order_filter"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first purchase order!
            </p>
        </field>
    </record>

    <!-- 5. Submenu inside Purchase -> Orders dropdown -->
    <menuitem id="menu_purchase_order_records"
              name="Purchase Order Records"
              parent="purchase.menu_procurement_management"
              action="action_custom_purchase_orders"
              sequence="30"/>
</odoo>
