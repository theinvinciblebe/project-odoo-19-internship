<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Form View -->
    <record id="view_procurement_request_form" model="ir.ui.view">
        <field name="name">procurement.request.form</field>
        <field name="model">procurement.request</field>
        <field name="arch" type="xml">
            <form string="Procurement Request">
                <header>
                    <button name="action_submit"
                            string="Submit Request"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-success"
                            invisible="state != 'submitted'"
                            groups="mini_procurement.group_procurement_manager"/>
                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"
                            invisible="state != 'submitted'"
                            groups="mini_procurement.group_procurement_manager"/>
                    <button name="action_create_rfq"
                            string="Generate Purchase Order"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'approved' or purchase_order_id"/>
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state not in ('rejected', 'cancel') or purchase_order_id"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state not in ('draft', 'submitted', 'approved') or purchase_order_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_order"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart"
                                invisible="not purchase_order_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">1</span>
                                <span class="o_stat_text">Purchase Order</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Procurement Request"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Requisition Details">
                            <field name="requested_by" widget="many2one_avatar_user" readonly="state != 'draft'"/>
                            <field name="date_request" readonly="state != 'draft'"/>
                            <field name="date_required" readonly="state not in ('draft', 'submitted')"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group string="Procurement Context">
                            <field name="assigned_approver" widget="many2one_avatar_user" readonly="state not in ('draft', 'submitted')"/>
                            <field name="partner_id" options="{'no_quick_create': True}" readonly="state not in ('draft', 'submitted')"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="estimated_total" widget="monetary" readonly="1" class="fw-bold fs-5 text-primary"/>
                            <field name="purchase_order_id" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Requisition Lines" name="lines">
                            <field name="line_ids" readonly="state not in ('draft', 'submitted')">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="estimated_cost" widget="monetary"/>
                                    <field name="price_subtotal" widget="monetary" sum="Total Estimated"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Justification / Notes" name="description">
                            <field name="description" placeholder="Describe the business requirement, project code, or justification..." readonly="state not in ('draft', 'submitted')"/>
                        </page>
                        <page string="Rejection Details" name="rejection" invisible="state != 'rejected'">
                            <group>
                                <field name="rejection_reason" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- 2. List View -->
    <record id="view_procurement_request_list" model="ir.ui.view">
        <field name="name">procurement.request.list</field>
        <field name="model">procurement.request</field>
        <field name="arch" type="xml">
            <list string="Procurement Requests"
                  decoration-info="state == 'submitted'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'cancel'">
                <field name="priority" widget="priority" optional="show"/>
                <field name="name" decoration-bf="1"/>
                <field name="date_request"/>
                <field name="date_required" optional="show"/>
                <field name="requested_by" widget="many2one_avatar_user"/>
                <field name="assigned_approver" widget="many2one_avatar_user"/>
                <field name="partner_id"/>
                <field name="estimated_total" widget="monetary" sum="Total Outlay"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state == 'cancel'"/>
                <field name="purchase_order_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- 3. Kanban View -->
    <record id="view_procurement_request_kanban" model="ir.ui.view">
        <field name="name">procurement.request.kanban</field>
        <field name="model">procurement.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="requested_by"/>
                <field name="date_request"/>
                <field name="estimated_total"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="priority"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-1">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title fs-6"><field name="name"/></strong>
                                </div>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="text-muted small">
                                <i class="fa fa-user me-1" title="Requester"/> <field name="requested_by"/>
                            </div>
                            <div class="text-muted small" t-if="record.partner_id">
                                <i class="fa fa-truck me-1" title="Vendor"/> <field name="partner_id"/>
                            </div>
                            <div class="o_kanban_record_bottom mt-2 pt-2 border-top">
                                <div class="oe_kanban_bottom_left">
                                    <field name="date_request"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span class="fw-bold text-primary">
                                        <field name="estimated_total" widget="monetary"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- 4. Search View -->
    <record id="view_procurement_request_search" model="ir.ui.view">
        <field name="name">procurement.request.search</field>
        <field name="model">procurement.request</field>
        <field name="arch" type="xml">
            <search string="Search Procurement Requests">
                <field name="name" string="Reference"/>
                <field name="requested_by"/>
                <field name="assigned_approver"/>
                <field name="partner_id"/>

                <filter string="My Requests" name="my_requests" domain="[('requested_by', '=', uid)]"/>
                <filter string="To Approve" name="to_approve" domain="[('state', '=', 'submitted'), ('assigned_approver', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="High &amp; Urgent Priority" name="high_priority" domain="[('priority', 'in', ('2', '3'))]"/>

                <group>
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Requester" name="group_requester" domain="[]" context="{'group_by': 'requested_by'}"/>
                    <filter string="Approver" name="group_approver" domain="[]" context="{'group_by': 'assigned_approver'}"/>
                    <filter string="Suggested Vendor" name="group_vendor" domain="[]" context="{'group_by': 'partner_id'}"/>
                    <filter string="Request Date" name="group_date" domain="[]" context="{'group_by': 'date_request'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 5. Action Window -->
    <record id="action_procurement_request" model="ir.actions.act_window">
        <field name="name">Procurement Requests</field>
        <field name="res_model">procurement.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_procurement_request_search"/>
        <field name="context">{'search_default_my_requests': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Procurement Request!
            </p>
            <p>
                Draft items, specify estimated budgets, assign an approver, and convert approved requisitions directly into Purchase Orders.
            </p>
        </field>
    </record>
</odoo>
