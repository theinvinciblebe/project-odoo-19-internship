<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Pivot View -->
    <record id="view_procurement_approval_report_pivot" model="ir.ui.view">
        <field name="name">procurement.approval.report.pivot</field>
        <field name="model">procurement.approval.report</field>
        <field name="arch" type="xml">
            <pivot string="Procurement Approval Analysis" sample="1">
                <field name="assigned_approver" type="row"/>
                <field name="state" type="col"/>
                <field name="estimated_total" type="measure"/>
                <field name="line_count" type="measure"/>
                <field name="po_amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- 2. Graph View -->
    <record id="view_procurement_approval_report_graph" model="ir.ui.view">
        <field name="name">procurement.approval.report.graph</field>
        <field name="model">procurement.approval.report</field>
        <field name="arch" type="xml">
            <graph string="Procurement Spend by Approver" type="bar" sample="1">
                <field name="assigned_approver"/>
                <field name="estimated_total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- 3. Search View -->
    <record id="view_procurement_approval_report_search" model="ir.ui.view">
        <field name="name">procurement.approval.report.search</field>
        <field name="model">procurement.approval.report</field>
        <field name="arch" type="xml">
            <search string="Search Procurement Approval Analysis">
                <field name="name" string="Requisition"/>
                <field name="requested_by"/>
                <field name="assigned_approver"/>
                <field name="partner_id"/>
                <field name="purchase_order_id"/>

                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Converted to PO" name="has_po" domain="[('purchase_order_id', '!=', False)]"/>
                <separator/>
                <filter string="Credit Approved Vendors" name="credit_approved" domain="[('is_credit_approved', '=', True)]"/>

                <group>
                    <filter string="Approver" name="group_approver" domain="[]" context="{'group_by': 'assigned_approver'}"/>
                    <filter string="Vendor" name="group_vendor" domain="[]" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Vendor Tier" name="group_tier" domain="[]" context="{'group_by': 'partner_tier'}"/>
                    <filter string="Request Month" name="group_month" domain="[]" context="{'group_by': 'date_request:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 4. Action Window -->
    <record id="action_procurement_approval_report" model="ir.actions.act_window">
        <field name="name">Approval Analysis</field>
        <field name="res_model">procurement.approval.report</field>
        <field name="view_mode">pivot,graph</field>
        <field name="search_view_id" ref="view_procurement_approval_report_search"/>
        <field name="context">{'search_default_approved': 1, 'group_by': []}</field>
    </record>
</odoo>
