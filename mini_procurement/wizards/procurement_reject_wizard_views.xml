<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_procurement_reject_wizard_form" model="ir.ui.view">
        <field name="name">procurement.reject.wizard.form</field>
        <field name="model">procurement.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Procurement Request">
                <group>
                    <field name="request_id" readonly="1" options="{'no_open': True}"/>
                    <field name="reason" placeholder="State the reason why this procurement request is being rejected..."/>
                </group>
                <footer>
                    <button string="Confirm Rejection" name="action_confirm_rejection" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
