<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- explicit list view definition -->
        <record id="view_users_form_inherit_custom" model="ir.ui.view">
            <field name="name">res.users.form.inherit.custom</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form/sheet" position="inside">
                    <group string="Additional Information">
                        <field name="department_name"/>
                        <field name="phone_number"/>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="view_users_list_inherit_custom" model="ir.ui.view">
            <field name="name">res.users.list.inherit.custom</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <field name="department_name"/>
                    <field name="phone_number"/>
                </xpath>
            </field>
        </record>

        <!-- actions opening views on models -->

        <record id="action_user_management" model="ir.actions.act_window">
            <field name="name">Users</field>
            <field name="res_model">res.users</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first users record!
                </p>
            </field>
        </record>

        <!-- Top-Level Root App (Appears directly on Home Screen) -->
        <menuitem id="menu_user_management_root"
                  name="User Management"
                  web_icon="user_management,static/description/icon.png"
                  sequence="1"/>

        <!-- Users Menu -->
        <menuitem id="menu_purchase_request_partners"
                  name="Users"
                  parent="menu_user_management_root"
                  action="action_user_management"
                  sequence="20"/>


