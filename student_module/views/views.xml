<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- ======================================================== -->
    <!--                   STUDENT VIEWS & ACTION                 -->
    <!-- ======================================================== -->

    <!-- 1. Student List View -->
    <record id="student_module_view_list" model="ir.ui.view">
      <field name="name">student.module.list</field>
      <field name="model">student.module</field>
      <field name="arch" type="xml">
        <list decoration-danger="avg &lt; 50"
              decoration-warning="avg &gt;= 50 and avg &lt; 70"
              decoration-success="avg &gt;= 70">
          <field name="name"/>
          <field name="classroom_id"/>
          <field name="avg"
                 widget="badge"
                 decoration-danger="avg &lt; 50"
                 decoration-warning="avg &gt;= 50 and avg &lt; 70"
                 decoration-success="avg &gt;= 70"/>
          <field name="description" optional="show"/>
        </list>
      </field>
    </record>

    <!-- 2. Student Kanban View -->
    <record id="student_module_view_kanban" model="ir.ui.view">
      <field name="name">student.module.kanban</field>
      <field name="model">student.module</field>
      <field name="arch" type="xml">
        <kanban>
          <field name="name"/>
          <field name="classroom_id"/>
          <field name="avg"/>
          <templates>
            <t t-name="card">
              <div class="oe_kanban_global_click p-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <strong><field name="name"/></strong>
                  <span t-attf-class="badge rounded-pill #{record.avg.raw_value &lt; 50 ? 'text-bg-danger' : (record.avg.raw_value &lt; 70 ? 'text-bg-warning' : 'text-bg-success')}">
                    <t t-esc="record.avg.value"/>
                  </span>
                </div>
                <div>Class: <field name="classroom_id"/></div>
                <div class="text-muted small">Avg: <field name="avg"/></div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <!-- 3. Student Form View with Chatter -->
    <record id="student_module_view_form" model="ir.ui.view">
      <field name="name">student.module.form</field>
      <field name="model">student.module</field>
      <field name="arch" type="xml">
        <form string="Student">
          <sheet>
            <div class="oe_title">
              <h1>
                <field name="name" placeholder="Student Name..."/>
              </h1>
            </div>
            <group>
              <group>
                <field name="classroom_id"/>
              </group>
              <group>
                <field name="avg"/>
              </group>
            </group>
            <notebook>
              <page string="Description">
                <field name="description" placeholder="Notes..."/>
              </page>
            </notebook>
          </sheet>

          <!-- Chatter container -->
          <chatter reload_on_attachment="True"/>
        </form>
      </field>
    </record>

    <!-- 4. Student Action -->
    <record id="action_student_module" model="ir.actions.act_window">
      <field name="name">Students</field>
      <field name="res_model">student.module</field>
      <field name="view_mode">list,kanban,form</field>
    </record>


    <!-- ======================================================== -->
    <!--                  CLASSROOM VIEWS & ACTION                -->
    <!-- ======================================================== -->

    <!-- 5. Classroom List View -->
    <record id="student_classroom_view_list" model="ir.ui.view">
      <field name="name">student.classroom.list</field>
      <field name="model">student.classroom</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="code"/>
        </list>
      </field>
    </record>

    <!-- 6. Classroom Form View -->
    <record id="student_classroom_view_form" model="ir.ui.view">
      <field name="name">student.classroom.form</field>
      <field name="model">student.classroom</field>
      <field name="arch" type="xml">
        <form string="Classroom">
          <sheet>
            <div class="oe_title">
              <h1>
                <field name="name" placeholder="Classroom Name..."/>
              </h1>
            </div>
            <field name="code" placeholder="eg. 7123"/>
          </sheet>
        </form>
      </field>
    </record>

    <!-- 7. Classroom Action (Fixed: previously missing) -->
    <record id="action_student_classroom" model="ir.actions.act_window">
      <field name="name">Classrooms</field>
      <field name="res_model">student.classroom</field>
      <field name="view_mode">list,form</field>
    </record>


    <!-- ======================================================== -->
    <!--                           MENUS                          -->
    <!-- ======================================================== -->

    <!-- Root Menu -->
    <menuitem id="menu_student_root"
              name="Students"
              sequence="10"/>

    <!-- Submenu: Students -->
    <menuitem id="menu_student_list"
              name="Student Records"
              parent="menu_student_root"
              action="action_student_module"
              sequence="10"/>

    <!-- Submenu: Classrooms -->
    <menuitem id="menu_classroom_list"
              name="Classrooms"
              parent="menu_student_root"
              action="action_student_classroom"
              sequence="20"/>

  </data>
</odoo>