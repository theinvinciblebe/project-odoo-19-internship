<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- 1. Security Groups -->
        <record id="group_task_user" model="res.groups">
            <field name="name">Task: User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_task_manager" model="res.groups">
            <field name="name">Task: Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_task_user'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <!-- 2. Record Rules -->
        <record id="rule_task_record_user" model="ir.rule">
            <field name="name">User: Own or Unassigned Tasks</field>
            <field name="model_id" ref="model_task_record"/>
            <field name="groups" eval="[(4, ref('group_task_user'))]"/>
            <field name="domain_force">['|', ('user_id', '=', False), ('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_task_record_manager" model="ir.rule">
            <field name="name">Manager: All Tasks</field>
            <field name="model_id" ref="model_task_record"/>
            <field name="groups" eval="[(4, ref('group_task_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>