<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_approval_export_wizard_form" model="ir.ui.view">
        <field name="name">purchase.approval.export.wizard.form</field>
        <field name="model">purchase.approval.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Approval Report to Excel">
                <field name="file_data" invisible="1"/>
                <field name="filename" invisible="1"/>

                <!-- Mode 1: Filters (Shown before generating) -->
                <div invisible="file_data">
                    <p class="text-muted">
                        Select date intervals or filtering parameters to generate a customized XLSX audit report.
                    </p>
                    <group>
                        <group string="Date Range">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Audit Filters">
                            <field name="approval_tier"/>
                            <field name="approved_by_id"/>
                        </group>
                    </group>
                </div>

                <!-- Mode 2: Download Card (Shown after generating) -->
                <div invisible="not file_data" class="alert alert-success text-center" role="alert">
                    <h5 class="fw-bold mb-2">Your Excel Audit Report is Ready!</h5>
                    <p class="mb-3 text-muted">Click the button below to download the generated spreadsheet.</p>
                    <field name="file_data" filename="filename" widget="binary"/>
                </div>

                <footer>
                    <button name="action_generate_xlsx" string="Generate XLSX" type="object"
                            class="btn-primary" invisible="file_data"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record id="action_purchase_approval_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Approvals (XLSX)</field>
        <field name="res_model">purchase.approval.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Direct Menu Entry under Purchase -> Reporting -->
    <menuitem id="menu_purchase_approval_export_xlsx"
              name="Export Approvals (XLSX)"
              parent="purchase.purchase_report_main"
              action="action_purchase_approval_export_wizard"
              sequence="30"/>
</odoo>