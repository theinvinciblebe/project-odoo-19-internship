<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================== -->
    <!-- 1. FIRST MODULE LIST / TREE VIEW                                      -->
    <!-- Tabular listing view for 'first.module' records.                      -->
    <!-- ===================================================================== -->
    <record id="view_first_module_tree" model="ir.ui.view">
        <field name="name">first.module.tree</field>
        <field name="model">first.module</field>
        <field name="arch" type="xml">
            <list>
                <!-- Record title/name -->
                <field name="name"/>
                <!-- Numeric integer value -->
                <field name="value"/>
                <!-- Computed/derived value percentage or secondary score -->
                <field name="value2"/>
            </list>
        </field>
    </record>

    <!-- ===================================================================== -->
    <!-- 2. FIRST MODULE FORM VIEW                                             -->
    <!-- Detail editing view with sheet, description tab, and chatter feed.    -->
    <!-- ===================================================================== -->
    <record id="view_first_module_form" model="ir.ui.view">
        <field name="name">first.module.form</field>
        <field name="model">first.module</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!-- Main Field Group -->
                    <group>
                        <field name="name"/>
                        <field name="value"/>
                        <field name="value2"/>
                    </group>

                    <!-- Tabbed Notebook for extended notes -->
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>

                <!-- Modern Odoo Chatter: Activities, Log Notes, and Follower Messaging -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===================================================================== -->
    <!-- 3. WINDOW ACTION                                                      -->
    <!-- Window action to open first.module records in List and Form modes.    -->
    <!-- ===================================================================== -->
    <record id="action_first_module" model="ir.actions.act_window">
        <field name="name">First Modules</field>
        <field name="res_model">first.module</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===================================================================== -->
    <!-- 4. MENU NAVIGATION                                                    -->
    <!-- Root application menu item and child record link.                     -->
    <!-- ===================================================================== -->
    <!-- Root App Menu -->
    <menuitem id="menu_first_module_root"
              name="My First App"
              sequence="10"/>

    <!-- Submenu item executing the Window Action -->
    <menuitem id="menu_first_module_records"
              name="Records"
              parent="menu_first_module_root"
              action="action_first_module"
              sequence="10"/>

</odoo>