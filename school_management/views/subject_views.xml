<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================== -->
    <!-- 1. SUBJECT LIST VIEW                                                  -->
    <!-- Fast, in-place editable list for school academic subjects.             -->
    <!-- 'editable="bottom"' allows creating and modifying entries in the grid.-->
    <!-- ===================================================================== -->
    <record id="view_school_subject_list" model="ir.ui.view">
        <field name="name">school.subject.list</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <!-- editable="bottom": Opens new rows directly at the bottom without switching to form view -->
            <list string="Subjects" editable="bottom">
                <!-- Subject Name (e.g. Mathematics, Physics, History) -->
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- ===================================================================== -->
    <!-- 2. SUBJECT WINDOW ACTION                                              -->
    <!-- Action to open Subject records in list and form modes.                -->
    <!-- ===================================================================== -->
    <record id="action_school_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">school.subject</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===================================================================== -->
    <!-- 3. MENU NAVIGATION                                                    -->
    <!-- Submenu item under School Management for Subject curriculum records.  -->
    <!-- ===================================================================== -->
    <menuitem id="menu_school_subjects"
              name="Subjects"
              parent="menu_school_root"
              action="action_school_subject"
              sequence="30"/>

</odoo>